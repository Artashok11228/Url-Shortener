APP_NAME="URL Shortener"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker (Sail) defaults. For a local MySQL use 127.0.0.1 and your own credentials.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shortener
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Phase 4: redirect lookups use the Redis cache store. Queue stays sync until phase 5.
CACHE_STORE=redis
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shortener settings. See config/shortener.php for what each one does.
SHORTENER_CODE_LENGTH=7
SHORTENER_CACHE_TTL=3600
SHORTENER_CLICK_RETENTION_DAYS=365
SHORTENER_BLOCKLIST_DRIVER=none

# Sail
WWWGROUP=1000
WWWUSER=1000
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
